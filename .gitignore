# Bytecode e caches Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Variáveis de ambiente e segredos
.env
.env.*

# IDEs e editores
.vscode/
.idea/
*.swp
*.swo

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Logs temporários
*.log

# Dados gerados localmente (mantém apenas .gitkeep no repositório)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
